@{
    ViewData["Title"] = $"Census Summary for {Model.TrustName}";
}
@model SchoolAccount.Alpha.ViewModels.CensusTrustViewModel


<h1 class="govuk-heading-m">@Model.CollectionName</h1>

<p class="govuk-body">
    Avaiable @Model.CollectionOpenDate.Value.ToString("dd MMM yyyy"), due @Model.CollectionDueDate.Value.ToString("dd MMM yyyy").
</p>



<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Name</th>
            <th scope="row" class="govuk-table__header">Due</th>
            <th scope="row" class="govuk-table__header">Action</th>
            <th scope="row" class="govuk-table__header">Status</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var census in Model.CensusDetails)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@census.SchoolName</td>
                <td class="govuk-table__cell">
                    @Model.CollectionDueDate.Value.ToString("dd MMM yyyy")
                </td>
               <td class="govuk-table__cell">
                    @if (census.TagColor == "green")
                    {
                        <span>No action required</span>
                    }
                    else
                    {
                        <a href="#">Complete as school</a>
                    }
                </td>
                <td class="govuk-table__cell">
                    <strong class="govuk-tag govuk-tag--@census.TagColor">
                        @census.Status
                    </strong>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.CensusDetails.Any())
{
    <p class="govuk-body">No census data available for this trust.</p>
}

<p class="govuk-body">
    <a asp-controller="Home" asp-action="Trust" asp-route-ukprn="@Model.TrustUkprn" class="govuk-link">Back to trust details</a>
</p>