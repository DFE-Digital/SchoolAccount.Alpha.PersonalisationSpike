@{
    ViewData["Title"] = $"Establishments for {Model.TrustName} ({Model.TrustUkPrn})";
}
@model SchoolAccount.Alpha.ViewModels.GroupViewModel


<h1 class="govuk-heading-l">Trust Details - @Model.TrustName</h1>

<h2 class="govuk-heading-m">Census Status</h2>

<p class="govuk-body">
    @Model.CensusHeadline<br />
    <a asp-controller="Census" asp-action="Trust" asp-route-ukprn="@Model.TrustUkPrn">View more details</a>
</p>

<partial name="_UpcomingCensuses" model="Model.Censuses" />
<h2 class="govuk-heading-m">The trust includes the following establishments:</h2>
<ul class="govuk-list">
    @foreach (var org in Model.Establishments)
    {
        <li>
            <a class="govuk-link" asp-action="School" asp-route-ukprn="@org.Ukprn">
                <strong>@org.EstablishmentName</strong>
                @if (!string.IsNullOrEmpty(org.Ukprn))
                {
                    <text> (UKPRN: @org.Ukprn)</text>
                }
            </a>
        </li>
    }
</ul>